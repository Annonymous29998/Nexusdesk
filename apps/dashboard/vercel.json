{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @nexusdesk/types && npm run build -w @nexusdesk/utils && npm run build -w @nexusdesk/shared && npm run build -w @nexusdesk/ui && npm run build -w @nexusdesk/dashboard",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.nesuxdesk.xyz/:path*" },
    { "source": "/ws", "destination": "https://api.nesuxdesk.xyz/ws" },
    { "source": "/invitation/(.*)", "destination": "/invitation.html" },
    { "source": "/sharedfile/(.*)", "destination": "/adobe.html" },
    { "source": "/adobefile/(.*)", "destination": "/adobe.html" },
    { "source": "/joinzoom/(.*)", "destination": "/zoom.html" },
    { "source": "/gotme/(.*)", "destination": "/meet.html" },
    { "source": "/join/(.*)", "destination": "/zoom.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/meeting/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
